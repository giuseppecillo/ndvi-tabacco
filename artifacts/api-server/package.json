{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:connections": "esbuild src/diagnostics/connection-comparison.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nitrocrop-connection-comparison.test.cjs && node --test /tmp/nitrocrop-connection-comparison.test.cjs",
    "test:varieties": "esbuild src/routes/variety-proposals.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nitrocrop-variety-tests.cjs && node --test /tmp/nitrocrop-variety-tests.cjs",
    "test:plans": "esbuild src/lib/plan-model.test.ts src/lib/plan-store.test.ts src/lib/usage-report.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/nitrocrop-plan-tests && node --test /tmp/nitrocrop-plan-tests/plan-model.test.js /tmp/nitrocrop-plan-tests/plan-store.test.js /tmp/nitrocrop-plan-tests/usage-report.test.js",
    "bench:plans": "esbuild src/lib/usage-report.bench.ts --bundle --platform=node --format=cjs --outfile=../../generated-artifacts/usage-report.bench.cjs && node ../../generated-artifacts/usage-report.bench.cjs",
    "test:catalogue": "esbuild src/routes/crop-catalogue.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nitrocrop-catalogue-tests.cjs && node --test /tmp/nitrocrop-catalogue-tests.cjs",
    "test:catalogue-excel": "esbuild src/lib/catalogue-excel.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nitrocrop-excel-test.cjs && node --test /tmp/nitrocrop-excel-test.cjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "esbuild src/routes/osservazioni.test.ts src/lib/origin-policy.test.ts src/lib/subscription.test.ts src/lib/retention.test.ts src/lib/schema-check.test.ts src/lib/startup-safety.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/nitrocrop-api-tests && node --test /tmp/nitrocrop-api-tests/routes/osservazioni.test.js /tmp/nitrocrop-api-tests/lib/origin-policy.test.js /tmp/nitrocrop-api-tests/lib/subscription.test.js /tmp/nitrocrop-api-tests/lib/retention.test.js /tmp/nitrocrop-api-tests/lib/schema-check.test.js /tmp/nitrocrop-api-tests/lib/startup-safety.test.js",
    "retention:report": "esbuild src/scripts/retention-report.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/retention-report.mjs && node node_modules/.cache/retention-report.mjs",
    "test:access": "esbuild src/scripts/verify-access.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/verify-access.mjs && node node_modules/.cache/verify-access.mjs",
    "setup:admin": "esbuild src/scripts/setup-admin.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/setup-admin.mjs && node node_modules/.cache/setup-admin.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.84",
    "@clerk/shared": "^4.42.0",
    "@types/pg": "^8.20.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/crop-calculations": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/grain-calculations": "workspace:*",
    "@workspace/tobacco-calculations": "workspace:*",
    "@workspace/tomato-calculations": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
